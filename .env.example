# MongoDB is the only production data store and auth/session backend.
# Keep these values server-side; never put the URI or passwords in VITE_* config.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=vantide

# On first login, the server creates this operator only if the email does not
# already exist. Remove the bootstrap password after the account is created.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_TTL_HOURS=24

# Optional machine credential for cron/CLI requests (x-admin-api-key).
ADMIN_API_KEY=
ADMIN_API_ALLOWED_ORIGINS=
ADMIN_API_REQUIRE_AUTH=true
# Production defaults both of these to false. Set them to true only for an
# intentional local/demo environment; memory records are not real operations.
ADMIN_API_ALLOW_MEMORY_STORE=false
ADMIN_API_SEED_EMPTY=false
# Set NODE_ENV=production in the deployed standalone server environment.

# Standalone server/local development.
ADMIN_API_BASE=/api/admin
PORT=8787
HOST=0.0.0.0
ADMIN_DATA_FILE=

# Browser-safe runtime value (also set in public/config.js).
# VITE_ADMIN_API_URL=/api/admin

# Treasury deployment only (never expose these through VITE_* variables).
# See docs/treasury-vault.md. Leave empty unless intentionally deploying.
TREASURY_RPC_URL=
TREASURY_CHAIN_ID=
TREASURY_OWNER_ADDRESS=
TREASURY_DEPLOYER_PRIVATE_KEY=
TREASURY_DEPLOY_CONFIRM=
TREASURY_DEPLOY_CONFIRMATIONS=2
