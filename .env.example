# ============================================================================
# Server-side configuration for the admin API.
# NEVER put any of these in public/config.js or a VITE_ variable: everything
# there is shipped to every browser.
#
# Vercel  → Project → Settings → Environment Variables
# Local   → copy to .env and run `npx tsx server/standalone.ts`
# ============================================================================

# --- Supabase (https://supabase.com/dashboard → Project Settings → API) ------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# "JWT Secret" on the same page. Used to verify admin sign-in tokens.
SUPABASE_JWT_SECRET=

# --- Access control ---------------------------------------------------------
# Comma separated emails allowed in even without app_metadata.role = "admin".
ADMIN_ALLOWLIST_EMAILS=
# Optional machine-to-machine key, sent as `x-admin-api-key`.
ADMIN_API_KEY=

# --- CORS -------------------------------------------------------------------
# Browser origins allowed to call the API. Leave empty to allow same-origin
# requests only (the usual setup when the API and dapp share a domain).
ADMIN_API_ALLOWED_ORIGINS=

# --- Runtime behaviour ------------------------------------------------------
# Base path / port for `npx tsx server/standalone.ts`.
ADMIN_API_BASE=/api/admin
PORT=8787
HOST=0.0.0.0
# Persist the bundled memory store between restarts (local development).
ADMIN_DATA_FILE=
# Set to "false" only to poke at the API locally without a token.
ADMIN_API_REQUIRE_AUTH=true
# Set to "false" to make the API fail instead of serving bundled demo data
# when Supabase credentials are missing.
ADMIN_API_ALLOW_MEMORY_STORE=true

# --- Browser (build/runtime) config for the dapp ----------------------------
# These belong in public/config.js, they are listed here for reference only:
#   VITE_SUPABASE_URL=https://xyzcompany.supabase.co
#   VITE_SUPABASE_ANON_KEY=eyJhbGciOi...   (anon key, safe for the browser)
#   VITE_ADMIN_API_URL=/api/admin
