+  const taker = Number(form.takerFee);
+  if (isNaN(maker) || maker < 0 || maker > 2) return "Maker fee must be between 0% and 2%.";
+  if (isNaN(taker) || taker < 0 || taker > 2) return "Taker fee must be between 0% and 2%.";
