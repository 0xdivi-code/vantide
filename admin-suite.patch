+            <Field label="Type">
+              <Select value={form.type} onChange={(e) => setForm({ ...form, type: e.target.value as RewardCampaign["type"] })}>
+                {["Trading Competition", "Deposit Campaign", "Referral Bonus", "Trading Rebate", "VIP Reward"].map((t) => <option key={t}>{t}</option>)}
