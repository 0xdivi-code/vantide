+  return defs.map(([code, discount, uses, maxUses], i) => ({
+    id: `cpn_${i}`,
+    code,
+    discount,
+    uses,
+    maxUses,
+    expiresAt: daysFromNow([30, 14, 60, 7, 3][i]),
+    status: i === 3 ? "paused" : "active",
